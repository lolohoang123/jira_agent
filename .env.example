# Secrets: in AWS these come from SSM Parameter Store (set SSM_PARAMETER_PREFIX=/jira-agent/<stage>/);
# the values below are only used locally when SSM_PARAMETER_PREFIX is unset.
# SSM_PARAMETER_PREFIX=/jira-agent/stg/

# Slack
SLACK_SIGNING_SECRET=replace-me
SLACK_BOT_TOKEN=xoxb-replace-me
ASYNC_TASK_SECRET=long-random-secret

# Atlassian OAuth 2.0 (3LO)
ATLASSIAN_CLIENT_ID=replace-me
ATLASSIAN_CLIENT_SECRET=replace-me
ATLASSIAN_REDIRECT_URI=https://YOUR_LAMBDA_FUNCTION_URL/oauth/callback
OAUTH_SCOPES=read:jira-user read:jira-work write:jira-work offline_access

# DynamoDB tables; partition keys: OAUTH_STATES_TABLE -> state, OAUTH_USERS_TABLE -> slack_user_id
OAUTH_STATES_TABLE=read-jira-oauth-states
OAUTH_USERS_TABLE=read-jira-users

# App preferences
JIRA_TIMEZONE=Asia/Ho_Chi_Minh
AWS_DEFAULT_REGION=ap-southeast-1
# Optional local DynamoDB endpoint
# DYNAMODB_ENDPOINT_URL=http://localhost:8000

# Approval requests (partition key: approval_id; enable TTL on attribute `ttl`)
APPROVALS_TABLE=read-jira-approvals
# Optional: keep finished approvals for audit (days) and cap a single worklog (minutes, default 24h)
# APPROVAL_RETENTION_DAYS=90
# MAX_WORKLOG_MINUTES=1440

# Amazon Bedrock (select a model that supports Converse in this region)
BEDROCK_MODEL_ID=replace-with-model-id
BEDROCK_REGION=ap-southeast-1

# Approval delivery: dm (default, private) or channel
# APPROVAL_DELIVERY=dm

# Per-user limit for natural-language (Bedrock) requests; table PK limit_key, TTL ttl
# RATE_LIMITS_TABLE=jira-agent-staging-rate-limits
# AGENT_RATE_LIMIT_PER_HOUR=20
